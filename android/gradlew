#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")"

# AGP 8.7.3 requires Gradle 8.9, so we pin that here for CI stability.
GRADLE_VERSION="8.9"

if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi

CACHE_DIR="${HOME:-/tmp}/.cache/jadefall-gradle"
GRADLE_HOME="$CACHE_DIR/gradle-$GRADLE_VERSION"
GRADLE_BIN="$GRADLE_HOME/bin/gradle"
ARCHIVE="$CACHE_DIR/gradle-$GRADLE_VERSION-bin.zip"
URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"

if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$CACHE_DIR"
  if [ ! -f "$ARCHIVE" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL -o "$ARCHIVE" "$URL"
    elif command -v wget >/dev/null 2>&1; then
      wget -q -O "$ARCHIVE" "$URL"
    else
      echo "Neither curl nor wget is available to download Gradle." >&2
      exit 127
    fi
  fi

  if command -v unzip >/dev/null 2>&1; then
    unzip -q -o "$ARCHIVE" -d "$CACHE_DIR"
  else
    echo "unzip is required to extract Gradle." >&2
    exit 127
  fi
fi

exec "$GRADLE_BIN" "$@"
